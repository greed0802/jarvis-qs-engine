{
  "pack_name": "alpha35_16_document_contract_tests",
  "version_target": "v5.0.0-alpha.36.3",
  "format": "multi_step",
  "tests": [
    {
      "name": "T01_VERSION_ALPHA35_16_LOCKS",
      "reset_conversation": true,
      "steps": [
        {
          "name": "version",
          "method": "GET",
          "endpoint": "/api/version",
          "assertions": [
            {
              "path": "$.version",
              "equals": "v5.0.0-alpha.36.3"
            },
            {
              "path": "$.execution_locks.workbook_read_enabled",
              "equals": false
            },
            {
              "path": "$.execution_locks.builder_engine_execution_enabled",
              "equals": false
            },
            {
              "path": "$.execution_locks.legacy_builder_callable",
              "equals": false
            },
            {
              "path": "$.execution_locks.excel_output_enabled",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "T02_SOURCE_AUTHORITIES_METADATA_ONLY",
      "reset_conversation": true,
      "steps": [
        {
          "name": "source_authorities",
          "method": "GET",
          "endpoint": "/api/registry/source-authorities",
          "assertions": [
            {
              "path": "$.metadata_only",
              "equals": true
            },
            {
              "path": "$.execution_enabled",
              "equals": false
            },
            {
              "path": "$.authorities[9].authority_key",
              "equals": "certifier_report"
            },
            {
              "path": "$.authorities[9].can_claim_compliance",
              "equals": false
            },
            {
              "path": "$.authorities[9].execution_enabled",
              "equals": false
            },
            {
              "path": "$.authorities[16].authority_key",
              "equals": "council_condition"
            },
            {
              "path": "$.authorities[16].can_claim_compliance",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "T03_DOCUMENT_READER_TOOL_DISABLED",
      "reset_conversation": true,
      "steps": [
        {
          "name": "tools",
          "method": "GET",
          "endpoint": "/api/registry/tools",
          "assertions": [
            {
              "path": "$.metadata_only",
              "equals": true
            },
            {
              "path": "$.execution_enabled",
              "equals": false
            },
            {
              "path": "$.tools[8].tool_key",
              "equals": "client_document_reader"
            },
            {
              "path": "$.tools[8].execution_enabled",
              "equals": false
            },
            {
              "path": "$.tools[8].document_read",
              "equals": false
            },
            {
              "path": "$.tools[8].ocr_enabled",
              "equals": false
            },
            {
              "path": "$.tools[8].rag_enabled",
              "equals": false
            },
            {
              "path": "$.tools[8].human_review_required",
              "equals": true
            }
          ]
        }
      ]
    },
    {
      "name": "T04_DOCUMENT_OCR_CAPABILITY_DISABLED",
      "reset_conversation": true,
      "steps": [
        {
          "name": "capabilities",
          "method": "GET",
          "endpoint": "/api/registry/capabilities",
          "assertions": [
            {
              "path": "$.metadata_only",
              "equals": true
            },
            {
              "path": "$.execution_enabled",
              "equals": false
            },
            {
              "path": "$.capabilities[6].capability_key",
              "equals": "document_ocr"
            },
            {
              "path": "$.capabilities[6].execution_enabled",
              "equals": false
            },
            {
              "path": "$.capabilities[6].document_read",
              "equals": false
            },
            {
              "path": "$.capabilities[6].ocr_enabled",
              "equals": false
            },
            {
              "path": "$.capabilities[6].rag_enabled",
              "equals": false
            },
            {
              "path": "$.capabilities[31].capability_key",
              "equals": "classify_document_type_contract"
            },
            {
              "path": "$.capabilities[31].execution_enabled",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "T05_FILE_REQUIREMENTS_DOCUMENT_TYPES_EXIST",
      "reset_conversation": true,
      "steps": [
        {
          "name": "file_requirements",
          "method": "GET",
          "endpoint": "/api/registry/file-requirements",
          "assertions": [
            {
              "path": "$.metadata_only",
              "equals": true
            },
            {
              "path": "$.execution_enabled",
              "equals": false
            },
            {
              "path": "$.file_requirements[38].file_key",
              "equals": "bca_ncc_report"
            },
            {
              "path": "$.file_requirements[38].document_read",
              "equals": false
            },
            {
              "path": "$.file_requirements[42].file_key",
              "equals": "arborist_report"
            },
            {
              "path": "$.file_requirements[42].ocr_enabled",
              "equals": false
            },
            {
              "path": "$.file_requirements[47].file_key",
              "equals": "document_contract_future"
            },
            {
              "path": "$.file_requirements[47].rag_enabled",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "T06_FUTURE_DOCUMENT_REQUEST_STILL_METADATA_ONLY",
      "reset_conversation": true,
      "steps": [
        {
          "name": "chat",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {
            "conversation_id": "alpha3516_document_request",
            "client_event_id": "alpha3516_document_request",
            "text": "Run Document Reader on this acoustic report"
          },
          "assertions": [
            {
              "path": "$.route",
              "equals": "registry_advisory_metadata_only"
            },
            {
              "path": "$.metadata_only",
              "equals": true
            },
            {
              "path": "$.execution_enabled",
              "equals": false
            },
            {
              "path": "$.workbook_read",
              "equals": false
            },
            {
              "path": "$.engine_called",
              "equals": false
            },
            {
              "path": "$.excel_created",
              "equals": false
            },
            {
              "path": "$.legacy_builder_called",
              "equals": false
            },
            {
              "path": "$.requirement_advisor.execution_blocked",
              "equals": true
            },
            {
              "path": "$.requirement_advisor.tool_execution_called",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "T07_WORKBOOK_READ_STILL_SAFE_BLOCKED",
      "reset_conversation": true,
      "steps": [
        {
          "name": "chat",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {
            "conversation_id": "alpha3516_read_workbook",
            "client_event_id": "alpha3516_read_workbook",
            "text": "Open the workbook and read all cell values"
          },
          "assertions": [
            {
              "path": "$.workbook_read",
              "equals": false
            },
            {
              "path": "$.engine_called",
              "equals": false
            },
            {
              "path": "$.excel_created",
              "equals": false
            },
            {
              "path": "$.legacy_builder_called",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "T08_ALPHA35_15_JOB_OUTPUT_STILL_DISABLED",
      "reset_conversation": true,
      "steps": [
        {
          "name": "policies",
          "method": "GET",
          "endpoint": "/api/registry/execution-policies",
          "assertions": [
            {
              "path": "$.policies[8].policy_key",
              "equals": "job_output_contract_map"
            },
            {
              "path": "$.policies[8].execution_enabled",
              "equals": false
            },
            {
              "path": "$.policies[8].metadata_only",
              "equals": true
            }
          ]
        }
      ]
    }
  ]
}
