{
  "pack_name": "alpha34_workbook_sheet_name_probe_approval_tests",
  "version_target": "v5.0.0-alpha.36.3",
  "format": "multi_step",
  "tests": [
    {
      "name": "VERSION_ALPHA34_SHEET_NAME_LOCKS",
      "reset_conversation": true,
      "steps": [
        {"name": "version", "method": "GET", "endpoint": "/api/version", "assertions": [
          {"path": "$.version", "equals": "v5.0.0-alpha.36.3"},
          {"path": "$.scope", "equals": "workbook_read_policy_review_no_content_read"},
          {"path": "$.scope_metadata.workbook_sheet_name_probe_approval_contract", "equals": true},
          {"path": "$.scope_metadata.workbook_sheet_names_enabled", "equals": true},
          {"path": "$.scope_metadata.workbook_parse_enabled", "equals": false},
          {"path": "$.execution_locks.workbook_read_enabled", "equals": false},
          {"path": "$.execution_locks.builder_engine_execution_enabled", "equals": false},
          {"path": "$.execution_locks.legacy_builder_callable", "equals": false},
          {"path": "$.execution_locks.excel_output_enabled", "equals": false}
        ]}
      ]
    },
    {
      "name": "SHEET_PROBE_NO_CONTRACT_BLOCKS",
      "reset_conversation": true,
      "steps": [
        {"name": "probe_no_contract", "method": "POST", "endpoint": "/api/builder/workbook-sheet-name-probe-approval", "json": {"conversation_id": "pack_alpha34_no_contract", "client_event_id": "probe", "approval_granted": false}, "assertions": [
          {"path": "$.route", "equals": "builder_workbook_sheet_name_probe_approval"},
          {"path": "$.blocked", "equals": true},
          {"path": "$.reason", "equals": "engine_contract_not_found"},
          {"path": "$.workbook_opened", "equals": false},
          {"path": "$.limited_metadata_read", "equals": false},
          {"path": "$.sheet_names_read", "equals": false},
          {"path": "$.workbook_read", "equals": false},
          {"path": "$.cells_read", "equals": false},
          {"path": "$.formulas_read", "equals": false},
          {"path": "$.engine_called", "equals": false},
          {"path": "$.excel_created", "equals": false},
          {"path": "$.legacy_builder_called", "equals": false},
          {"path": "$.saved_path", "not_exists": true},
          {"path": "$.path", "not_exists": true}
        ]}
      ]
    },
    {
      "name": "SHEET_PROBE_APPROVAL_REQUIRED_THEN_APPROVED",
      "reset_conversation": true,
      "steps": [
        {"name": "start", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha34_contract", "client_event_id": "start", "text": "Build me a BOQ"}, "assertions": [{"path": "$.route", "equals": "new_builder_task_shell"}]},
        {"name": "attach", "method": "POST", "endpoint": "/api/attach", "form": {"conversation_id": "pack_alpha34_contract", "client_event_id": "attach", "text": "Here"}, "file_fixture": "SheetProbe.xlsx", "assertions": [{"path": "$.route", "equals": "attachment_bind"}]},
        {"name": "trade", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha34_contract", "client_event_id": "trade", "text": "Use Wall Types"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "function", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha34_contract", "client_event_id": "func", "text": "Use XGETWALLAREA"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "unit", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha34_contract", "client_event_id": "unit", "text": "Unit m2"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "zone", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha34_contract", "client_event_id": "zone", "text": "Zone 1: Old and New"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "head", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha34_contract", "client_event_id": "head", "text": "Use Head 2 for Zone 1"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "levels", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha34_contract", "client_event_id": "levels", "text": "Levels GF to L3"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "snapshot", "method": "POST", "endpoint": "/api/builder/create-snapshot", "json": {"conversation_id": "pack_alpha34_contract", "client_event_id": "snapshot"}, "assertions": [{"path": "$.route", "equals": "builder_snapshot_created"}]},
        {"name": "adapter", "method": "POST", "endpoint": "/api/builder/adapter-dry-run", "json": {"conversation_id": "pack_alpha34_contract", "client_event_id": "adapter"}, "assertions": [{"path": "$.route", "equals": "builder_adapter_dry_run"}]},
        {"name": "contract", "method": "POST", "endpoint": "/api/builder/engine-contract", "json": {"conversation_id": "pack_alpha34_contract", "client_event_id": "contract"}, "assertions": [{"path": "$.route", "equals": "builder_engine_contract_created"}]},
        {"name": "probe_requires_approval", "method": "POST", "endpoint": "/api/builder/workbook-sheet-name-probe-approval", "json": {"conversation_id": "pack_alpha34_contract", "client_event_id": "probe_required", "approval_granted": false}, "assertions": [
          {"path": "$.route", "equals": "builder_workbook_sheet_name_probe_approval"},
          {"path": "$.blocked", "equals": true},
          {"path": "$.reason", "equals": "sheet_name_probe_approval_required"},
          {"path": "$.workbook_opened", "equals": false},
          {"path": "$.sheet_names_read", "equals": false},
          {"path": "$.workbook_read", "equals": false}
        ]},
        {"name": "probe_approved", "method": "POST", "endpoint": "/api/builder/workbook-sheet-name-probe-approval", "json": {"conversation_id": "pack_alpha34_contract", "client_event_id": "probe_approved", "approval_granted": true}, "assertions": [
          {"path": "$.route", "equals": "builder_workbook_sheet_name_probe_approval"},
          {"path": "$.blocked", "equals": false},
          {"path": "$.reason", "equals": "sheet_name_probe_approved_sheet_names_only"},
          {"path": "$.workbook_opened", "equals": true},
          {"path": "$.workbook_closed", "equals": true},
          {"path": "$.limited_metadata_read", "equals": true},
          {"path": "$.sheet_names_read", "equals": true},
          {"path": "$.sheet_count", "not_equals": 0},
          {"path": "$.workbook_read", "equals": false},
          {"path": "$.workbook_content_read", "equals": false},
          {"path": "$.cells_read", "equals": false},
          {"path": "$.formulas_read", "equals": false},
          {"path": "$.engine_called", "equals": false},
          {"path": "$.excel_created", "equals": false},
          {"path": "$.legacy_builder_called", "equals": false},
          {"path": "$.saved_path", "not_exists": true},
          {"path": "$.path", "not_exists": true}
        ]}
      ]
    }
  ]
}
