            {
              "path": "$.blocked",
              "equals": false
            },
            {
              "path": "$.workbook_read",
              "equals": false
            },
            {
              "path": "$.engine_called",
              "equals": false
            },
            {
              "path": "$.excel_created",
              "equals": false
            },
            {
              "path": "$.legacy_builder_called",
              "equals": false
            }
          ]
        },
        {
          "name": "adapter_dry_run",
          "method": "POST",
          "endpoint": "/api/builder/adapter-dry-run",
          "json": {
            "conversation_id": "alpha35_10_1_uae_pack_flow",
            "client_event_id": "a35101_uae_evt_010"
          },
          "assertions": [
            {
              "path": "$.route",
              "equals": "builder_adapter_dry_run"
            },
            {
              "path": "$.blocked",
              "equals": false
            },
            {
              "path": "$.workbook_read",
              "equals": false
            },
            {
              "path": "$.engine_called",
              "equals": false
            },
            {
              "path": "$.excel_created",
              "equals": false
            },
            {
              "path": "$.legacy_builder_called",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "ASCENDING_BASEMENT_RANGE_STILL_CLARIFIES",
      "conversation_id": "alpha35_10_1_ascending_basement_guard",
      "reset_conversation": true,
      "steps": [
        {
          "name": "start_builder",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {
            "conversation_id": "alpha35_10_1_ascending_basement_guard",
            "client_event_id": "a35101_asc_evt_001",
            "text": "Build me a BOQ"
          },
          "assertions": [
            {
              "path": "$.route",
              "equals": "new_builder_task_shell"
            }
          ]
        },
        {
          "name": "set_ascending_basements",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {
            "conversation_id": "alpha35_10_1_ascending_basement_guard",
            "client_event_id": "a35101_asc_evt_002",
            "text": "Levels B2 to B5"
          },
          "assertions": [
            {
              "path": "$.route",
              "equals": "active_task_slot_edit_needs_clarification"
            },
            {
              "path": "$.reducer_result.conflict_type",
              "equals": "ambiguous_basement_range"
            },
            {
              "path": "$.pending_clarification_id",
              "exists": true
            }
          ]
        }
      ]
    }
  ]
