{
  "pack_name": "alpha29_safe_workbook_path_resolver_dry_run_tests",
  "version_target": "v5.0.0-alpha.36.3",
  "format": "multi_step",
  "tests": [
    {
      "name": "VERSION_ALPHA29_SAFE_WORKBOOK_PATH_RESOLVER_LOCKS",
      "reset_conversation": true,
      "steps": [
        {
          "name": "version",
          "method": "GET",
          "endpoint": "/api/version",
          "assertions": [
            {"path": "$.version", "equals": "v5.0.0-alpha.36.3"},
            {"path": "$.scope", "equals": "workbook_read_policy_review_no_content_read"},
            {"path": "$.scope_metadata.safe_workbook_path_resolver_dry_run", "equals": true},
            {"path": "$.scope_metadata.workbook_path_resolution_enabled", "equals": false},
            {"path": "$.scope_metadata.workbook_filesystem_check_enabled", "equals": false},
            {"path": "$.scope_metadata.workbook_open_enabled", "equals": false},
            {"path": "$.execution_locks.workbook_read_enabled", "equals": false},
            {"path": "$.execution_locks.builder_engine_execution_enabled", "equals": false},
            {"path": "$.execution_locks.legacy_builder_callable", "equals": false},
            {"path": "$.execution_locks.excel_output_enabled", "equals": false}
          ]
        }
      ]
    },
    {
      "name": "RESOLVER_NO_CONTRACT_BLOCKS_SAFELY",
      "reset_conversation": true,
      "steps": [
        {
          "name": "resolver_no_contract",
          "method": "POST",
          "endpoint": "/api/builder/safe-workbook-path-resolver-dry-run",
          "json": {"conversation_id": "pack_alpha29_no_contract", "client_event_id": "resolver_no_contract"},
          "assertions": [
            {"path": "$.route", "equals": "builder_safe_workbook_path_resolver_dry_run"},
            {"path": "$.metadata_only", "equals": true},
            {"path": "$.execution_enabled", "equals": false},
            {"path": "$.blocked", "equals": true},
            {"path": "$.reason", "equals": "engine_contract_not_found"},
            {"path": "$.contract_found", "equals": false},
            {"path": "$.workbook_ref_found", "equals": false},
            {"path": "$.workbook_ref_summary.found", "equals": false},
            {"path": "$.path_resolved", "equals": false},
            {"path": "$.filesystem_checked", "equals": false},
            {"path": "$.workbook_filesystem_checked", "equals": false},
            {"path": "$.workbook_opened", "equals": false},
            {"path": "$.workbook_read", "equals": false},
            {"path": "$.engine_called", "equals": false},
            {"path": "$.excel_created", "equals": false},
            {"path": "$.legacy_builder_called", "equals": false},
            {"path": "$.raw_path_value_returned", "equals": false},
            {"path": "$.forbidden_path_key_returned", "equals": false}
          ]
        }
      ]
    },
    {
      "name": "RESOLVER_READY_CONTRACT_SCRUBBED_WORKBOOK_SUMMARY",
      "reset_conversation": true,
      "steps": [
        {"name": "start", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha29_contract", "client_event_id": "start", "text": "Build me a BOQ"}, "assertions": [{"path": "$.route", "equals": "new_builder_task_shell"}]},
        {"name": "attach", "method": "POST", "endpoint": "/api/attach", "form": {"conversation_id": "pack_alpha29_contract", "client_event_id": "attach", "text": "Here"}, "file_fixture": "Test.xlsx", "assertions": [{"path": "$.route", "equals": "attachment_bind"}, {"path": "$.reducer_result.workbook_read", "equals": false}]},
        {"name": "trade", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha29_contract", "client_event_id": "trade", "text": "Use Wall Types"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "function", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha29_contract", "client_event_id": "func", "text": "Use XGETWALLAREA"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "unit", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha29_contract", "client_event_id": "unit", "text": "Unit m2"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "zone", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha29_contract", "client_event_id": "zone", "text": "Zone 1: Old and New"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "head", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha29_contract", "client_event_id": "head", "text": "Use Head 2 for Zone 1"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "levels", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha29_contract", "client_event_id": "levels", "text": "Levels GF to L3"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "snapshot", "method": "POST", "endpoint": "/api/builder/create-snapshot", "json": {"conversation_id": "pack_alpha29_contract", "client_event_id": "snapshot"}, "assertions": [{"path": "$.route", "equals": "builder_snapshot_created"}, {"path": "$.workbook_read", "equals": false}]},
        {"name": "adapter", "method": "POST", "endpoint": "/api/builder/adapter-dry-run", "json": {"conversation_id": "pack_alpha29_contract", "client_event_id": "adapter"}, "assertions": [{"path": "$.route", "equals": "builder_adapter_dry_run"}, {"path": "$.workbook_read", "equals": false}]},
        {"name": "contract", "method": "POST", "endpoint": "/api/builder/engine-contract", "json": {"conversation_id": "pack_alpha29_contract", "client_event_id": "contract"}, "assertions": [{"path": "$.route", "equals": "builder_engine_contract_created"}, {"path": "$.contract.workbook_ref.saved_path", "exists": true}, {"path": "$.workbook_read", "equals": false}]},
        {
          "name": "resolver",
          "method": "POST",
          "endpoint": "/api/builder/safe-workbook-path-resolver-dry-run",
          "json": {"conversation_id": "pack_alpha29_contract", "client_event_id": "resolver"},
          "assertions": [
            {"path": "$.route", "equals": "builder_safe_workbook_path_resolver_dry_run"},
            {"path": "$.reason", "equals": "safe_workbook_path_resolver_dry_run_only"},
            {"path": "$.contract_found", "equals": true},
            {"path": "$.workbook_ref_found", "equals": true},
            {"path": "$.workbook_ref_summary.filename", "equals": "Test.xlsx"},
            {"path": "$.workbook_ref_summary.source", "equals": "upload"},
            {"path": "$.raw_saved_path_present", "equals": true},
            {"path": "$.path_like_metadata_present", "equals": true},
            {"path": "$.jarvis_metadata_store_read", "equals": true},
            {"path": "$.path_resolved", "equals": false},
            {"path": "$.filesystem_checked", "equals": false},
            {"path": "$.workbook_filesystem_checked", "equals": false},
            {"path": "$.workbook_opened", "equals": false},
            {"path": "$.workbook_read", "equals": false},
            {"path": "$.engine_called", "equals": false},
            {"path": "$.excel_created", "equals": false},
            {"path": "$.legacy_builder_called", "equals": false},
            {"path": "$.raw_path_value_returned", "equals": false},
            {"path": "$.forbidden_path_key_returned", "equals": false}
          ]
        }
      ]
    }
  ]
}
