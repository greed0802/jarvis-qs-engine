{
  "pack_name": "alpha35_14_tool_contract_map_tests",
  "version_target": "v5.0.0-alpha.36.3",
  "format": "multi_step",
  "tests": [
    {
      "name": "T01_VERSION_ALPHA35_14_LOCKS",
      "reset_conversation": true,
      "steps": [
        {
          "name": "version",
          "method": "GET",
          "endpoint": "/api/version",
          "assertions": [
            {"path": "$.version", "equals": "v5.0.0-alpha.36.3"},
            {"path": "$.execution_locks.workbook_read_enabled", "equals": false},
            {"path": "$.execution_locks.builder_engine_execution_enabled", "equals": false},
            {"path": "$.execution_locks.legacy_builder_callable", "equals": false},
            {"path": "$.execution_locks.excel_output_enabled", "equals": false}
          ]
        }
      ]
    },
    {
      "name": "T02_TOOL_CONTRACT_REGISTRY_METADATA_ONLY",
      "reset_conversation": true,
      "steps": [
        {
          "name": "tools",
          "method": "GET",
          "endpoint": "/api/registry/tools",
          "assertions": [
            {"path": "$.metadata_only", "equals": true},
            {"path": "$.execution_enabled", "equals": false},
            {"path": "$.tools[1].tool_key", "equals": "formatter"},
            {"path": "$.tools[1].metadata_only", "equals": true},
            {"path": "$.tools[1].execution_enabled", "equals": false},
            {"path": "$.tools[1].workbook_read_required", "equals": false},
            {"path": "$.tools[1].safety_policy.tool_execution_called", "equals": false},
            {"path": "$.tools[2].tool_key", "equals": "qa_checker"},
            {"path": "$.tools[2].execution_enabled", "equals": false},
            {"path": "$.tools[6].tool_key", "equals": "omission_addition"},
            {"path": "$.tools[6].execution_enabled", "equals": false}
          ]
        }
      ]
    },
    {
      "name": "T03_CAPABILITY_CONTRACT_REGISTRY_METADATA_ONLY",
      "reset_conversation": true,
      "steps": [
        {
          "name": "capabilities",
          "method": "GET",
          "endpoint": "/api/registry/capabilities",
          "assertions": [
            {"path": "$.metadata_only", "equals": true},
            {"path": "$.execution_enabled", "equals": false},
            {"path": "$.capabilities[1].capability_key", "equals": "format_workbook"},
            {"path": "$.capabilities[1].metadata_only", "equals": true},
            {"path": "$.capabilities[1].execution_enabled", "equals": false},
            {"path": "$.capabilities[1].workbook_read_required", "equals": false}
          ]
        }
      ]
    },
    {
      "name": "T04_EXECUTION_POLICY_CONTRACT_MAP_DISABLED",
      "reset_conversation": true,
      "steps": [
        {
          "name": "execution_policies",
          "method": "GET",
          "endpoint": "/api/registry/execution-policies",
          "assertions": [
            {"path": "$.metadata_only", "equals": true},
            {"path": "$.execution_enabled", "equals": false},
            {"path": "$.policies[0].execution_enabled", "equals": false}
          ]
        }
      ]
    },
    {
      "name": "T05_FUTURE_TOOL_RUN_STILL_METADATA_ONLY",
      "reset_conversation": true,
      "steps": [
        {
          "name": "run_formatter",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {"conversation_id": "a3514_run_formatter", "client_event_id": "run_formatter", "text": "Run Formatter on the Builder output"},
          "assertions": [
            {"path": "$.route", "equals": "registry_advisory_metadata_only"},
            {"path": "$.metadata_only", "equals": true},
            {"path": "$.execution_enabled", "equals": false},
            {"path": "$.requirement_advisor.future_tool_requested", "equals": true},
            {"path": "$.requirement_advisor.execution_blocked", "equals": true},
            {"path": "$.requirement_advisor.tool_execution_called", "equals": false},
            {"path": "$.workbook_read", "equals": false},
            {"path": "$.engine_called", "equals": false},
            {"path": "$.excel_created", "equals": false},
            {"path": "$.legacy_builder_called", "equals": false}
          ]
        },
        {
          "name": "run_oa",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {"conversation_id": "a3514_run_oa", "client_event_id": "run_oa", "text": "Run O&A on this workbook"},
          "assertions": [
            {"path": "$.route", "equals": "registry_advisory_metadata_only"},
            {"path": "$.requirement_advisor.execution_blocked", "equals": true},
            {"path": "$.workbook_read", "equals": false}
          ]
        }
      ]
    },
    {
      "name": "T06_ROUTE_SAFETY_REGRESSIONS",
      "reset_conversation": true,
      "steps": [
        {
          "name": "builder_start",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {"conversation_id": "a3514_builder", "client_event_id": "builder", "text": "Build me a BOQ"},
          "assertions": [
            {"path": "$.route", "equals": "new_builder_task_shell"},
            {"path": "$.fallback_used", "equals": false}
          ]
        },
        {
          "name": "read_block",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {"conversation_id": "a3514_read", "client_event_id": "read", "text": "Open workbook and read cells"},
          "assertions": [
            {"path": "$.route", "equals": "no_active_prompt_injection_safe_block"},
            {"path": "$.workbook_read", "equals": false},
            {"path": "$.engine_called", "equals": false},
            {"path": "$.excel_created", "equals": false},
            {"path": "$.legacy_builder_called", "equals": false}
          ]
        }
      ]
    }
  ]
}
