            {
              "path": "$.readiness.status",
              "equals": "contract_ready"
            },
            {
              "path": "$.workbook_read_policy.status",
              "equals": "reviewed"
            },
            {
              "path": "$.workbook_read_policy.workbook_read",
              "equals": false
            },
            {
              "path": "$.readiness.workbook_read_policy_status",
              "equals": "reviewed"
            },
            {
              "path": "$.readiness.workbook_read_policy_reviewed",
              "equals": true
            },
            {
              "path": "$.readiness.workbook_read_policy.status",
              "equals": "reviewed"
            },
            {
              "path": "$.readiness.workbook_read_policy.workbook_read",
              "equals": false
            },
            {
              "path": "$.readiness.workbook_read_policy.workbook_opened",
              "equals": false
            },
            {
              "path": "$.readiness.workbook_read_policy.cells_read",
              "equals": false
            },
            {
              "path": "$.readiness.workbook_read_policy.formulas_read",
              "equals": false
            },
            {
              "path": "$.readiness.safety.workbook_read",
              "equals": false
            },
            {
              "path": "$.readiness.safety.engine_called",
              "equals": false
            },
            {
              "path": "$.readiness.safety.excel_created",
              "equals": false
            },
            {
              "path": "$.readiness.safety.legacy_builder_called",
              "equals": false
            }
          ]
        }
      ]
    },
