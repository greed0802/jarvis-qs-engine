{
  "pack_name": "alpha27_preview_execution_policy_tests",
  "version_target": "v5.0.0-alpha.36.3",
  "format": "multi_step",
  "tests": [
    {
      "name": "VERSION_ALPHA27_POLICY_LOCKS",
      "reset_conversation": true,
      "steps": [
        {
          "name": "version",
          "method": "GET",
          "endpoint": "/api/version",
          "assertions": [
            {"path": "$.version", "equals": "v5.0.0-alpha.36.3"},
            {"path": "$.scope", "equals": "workbook_read_policy_review_no_content_read"},
            {"path": "$.engines_connected.preview_execution_policy", "equals": false},
            {"path": "$.execution_locks.builder_engine_execution_enabled", "equals": false},
            {"path": "$.execution_locks.legacy_builder_callable", "equals": false},
            {"path": "$.execution_locks.workbook_read_enabled", "equals": false},
            {"path": "$.execution_locks.excel_output_enabled", "equals": false}
          ]
        }
      ]
    },
    {
      "name": "PREVIEW_POLICY_NO_CONTRACT_METADATA_ONLY",
      "reset_conversation": true,
      "steps": [
        {
          "name": "policy_no_contract",
          "method": "POST",
          "endpoint": "/api/builder/preview-execution-policy",
          "json": {
            "conversation_id": "pack_alpha27_no_contract",
            "client_event_id": "pack_a27_no_contract",
            "requested_action": "preview"
          },
          "assertions": [
            {"path": "$.route", "equals": "builder_preview_execution_policy"},
            {"path": "$.metadata_only", "equals": true},
            {"path": "$.execution_enabled", "equals": false},
            {"path": "$.blocked", "equals": true},
            {"path": "$.reason", "equals": "engine_contract_not_found"},
            {"path": "$.workbook_read", "equals": false},
            {"path": "$.engine_called", "equals": false},
            {"path": "$.excel_created", "equals": false},
            {"path": "$.legacy_builder_called", "equals": false},
            {"path": "$.safety.workbook_read", "equals": false},
            {"path": "$.safety.engine_called", "equals": false},
            {"path": "$.safety.excel_created", "equals": false},
            {"path": "$.safety.legacy_builder_called", "equals": false},
            {"path": "$.contract_found", "equals": false},
            {"path": "$.contract_ready", "equals": false},
            {"path": "$.blocked_by_policy", "includes_all": ["workbook_read_disabled", "legacy_builder_callable_disabled", "excel_output_disabled", "execution_kill_switch", "engine_contract_not_ready"]},
            {"path": "$.preview_result_schema.schema_version", "equals": "builder_preview_result_v1"},
            {"path": "$.output_manifest_schema.schema_version", "equals": "builder_output_manifest_v1"},
            {"path": "$.background_job_boundary.job_enqueue_enabled", "equals": false}
          ]
        }
      ]
    },
    {
      "name": "PREVIEW_POLICY_WITH_READY_CONTRACT_STILL_BLOCKED",
      "reset_conversation": true,
      "steps": [
        {"name": "start", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha27_contract", "client_event_id": "start", "text": "Build me a BOQ"}, "assertions": [{"path": "$.route", "equals": "new_builder_task_shell"}]},
        {"name": "attach", "method": "POST", "endpoint": "/api/attach", "form": {"conversation_id": "pack_alpha27_contract", "client_event_id": "attach", "text": "Here"}, "file_fixture": "Test.xlsx", "assertions": [{"path": "$.route", "equals": "attachment_bind"}, {"path": "$.reducer_result.workbook_read", "equals": false}]},
        {"name": "trade", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha27_contract", "client_event_id": "trade", "text": "Use Wall Types"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "function", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha27_contract", "client_event_id": "func", "text": "Use XGETWALLAREA"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "unit", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha27_contract", "client_event_id": "unit", "text": "Unit m2"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "zone", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha27_contract", "client_event_id": "zone", "text": "Zone 1: Old and New"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "head", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha27_contract", "client_event_id": "head", "text": "Use Head 2 for Zone 1"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "levels", "method": "POST", "endpoint": "/api/chat", "json": {"conversation_id": "pack_alpha27_contract", "client_event_id": "levels", "text": "Levels GF to L3"}, "assertions": [{"path": "$.route", "equals": "active_task_slot_edit"}]},
        {"name": "snapshot", "method": "POST", "endpoint": "/api/builder/create-snapshot", "json": {"conversation_id": "pack_alpha27_contract", "client_event_id": "snapshot"}, "assertions": [{"path": "$.route", "equals": "builder_snapshot_created"}, {"path": "$.workbook_read", "equals": false}]},
        {"name": "adapter", "method": "POST", "endpoint": "/api/builder/adapter-dry-run", "json": {"conversation_id": "pack_alpha27_contract", "client_event_id": "adapter"}, "assertions": [{"path": "$.route", "equals": "builder_adapter_dry_run"}, {"path": "$.workbook_read", "equals": false}]},
        {"name": "contract", "method": "POST", "endpoint": "/api/builder/engine-contract", "json": {"conversation_id": "pack_alpha27_contract", "client_event_id": "contract"}, "assertions": [{"path": "$.route", "equals": "builder_engine_contract_created"}, {"path": "$.workbook_read", "equals": false}]},
        {
          "name": "preview_policy",
          "method": "POST",
          "endpoint": "/api/builder/preview-execution-policy",
          "json": {"conversation_id": "pack_alpha27_contract", "client_event_id": "policy", "requested_action": "preview"},
          "assertions": [
            {"path": "$.route", "equals": "builder_preview_execution_policy"},
            {"path": "$.reason", "equals": "preview_execution_disabled_by_policy"},
            {"path": "$.contract_found", "equals": true},
            {"path": "$.contract_ready", "equals": true},
            {"path": "$.execution_enabled", "equals": false},
            {"path": "$.workbook_read", "equals": false},
            {"path": "$.engine_called", "equals": false},
            {"path": "$.excel_created", "equals": false},
            {"path": "$.legacy_builder_called", "equals": false},
            {"path": "$.safe_workbook_path_resolver.status", "equals": "metadata_only"},
            {"path": "$.preview_approval_policy.preview_execution_enabled", "equals": false},
            {"path": "$.export_approval_policy.export_execution_enabled", "equals": false}
          ]
        }
      ]
    },
    {
      "name": "EXPORT_POLICY_REQUIRES_PREVIEW_FIRST",
      "reset_conversation": true,
      "steps": [
        {
          "name": "export_policy",
          "method": "POST",
          "endpoint": "/api/builder/preview-execution-policy",
          "json": {"conversation_id": "pack_alpha27_export", "client_event_id": "export_policy", "requested_action": "export"},
          "assertions": [
            {"path": "$.route", "equals": "builder_preview_execution_policy"},
            {"path": "$.requested_action", "equals": "export"},
            {"path": "$.blocked", "equals": true},
            {"path": "$.blocked_by_policy", "includes_all": ["preview_approval_required_before_export"]},
            {"path": "$.workbook_read", "equals": false},
            {"path": "$.engine_called", "equals": false},
            {"path": "$.excel_created", "equals": false},
            {"path": "$.legacy_builder_called", "equals": false}
          ]
        }
      ]
    }
  ]
}
