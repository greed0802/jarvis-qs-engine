    {
      "name": "CLARIFICATION_RESOLVED_FLAG_AND_NULL_PENDING_ID",
      "steps": [
        {
          "name": "start",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {
            "conversation_id": "alpha181_pack_clarification",
            "client_event_id": "a181_clar_start",
            "text": "Build me a BOQ"
          },
          "assertions": [
            {
              "path": "$.route",
              "equals": "new_builder_task_shell"
            }
          ]
        },
        {
          "name": "attach",
          "method": "POST",
          "endpoint": "/api/attach",
          "form": {
            "conversation_id": "alpha181_pack_clarification",
            "client_event_id": "a181_clar_attach",
            "text": "Here"
          },
          "file_fixture": "Test.xlsx",
          "assertions": [
            {
              "path": "$.route",
              "equals": "attachment_bind"
            }
          ]
        },
        {
          "name": "reinforcement",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {
            "conversation_id": "alpha181_pack_clarification",
            "client_event_id": "a181_clar_reo",
            "text": "Use Reinforcement"
          },
          "assertions": [
            {
              "path": "$.route",
              "equals": "active_task_slot_edit_needs_clarification"
            },
            {
              "path": "$.pending_clarification_id",
              "exists": true
            }
          ]
        },
        {
          "name": "resolve",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {
            "conversation_id": "alpha181_pack_clarification",
            "client_event_id": "a181_clar_resolve",
            "text": "Use XGETCUSTOM with Reinforcement Weight unit t"
          },
          "assertions": [
            {
              "path": "$.route",
              "equals": "clarification_resolved"
            },
            {
              "path": "$.clarification_resolved",
              "equals": true
            },
            {
              "path": "$.pending_clarification_id",
              "equals": null
            },
            {
              "path": "$.reducer_result.requires_clarification",
              "equals": false
            },
            {
              "path": "$.reducer_result.trade_registry.matched",
              "equals": true
            },
            {
              "path": "$.reducer_result.normalization.status",
              "equals": "clean"
            }
          ]
        }
      ]
