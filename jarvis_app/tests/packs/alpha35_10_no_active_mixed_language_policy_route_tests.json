{
  "pack_name": "alpha35_10_no_active_mixed_language_policy_route_tests",
  "version_target": "v5.0.0-alpha.36.3",
  "format": "multi_step",
  "tests": [
    {
      "name": "VERSION_ALPHA35_10_NO_ACTIVE_POLICY_LOCKS",
      "reset_conversation": true,
      "steps": [
        {
          "name": "version",
          "method": "GET",
          "endpoint": "/api/version",
          "assertions": [
            {
              "path": "$.version",
              "equals": "v5.0.0-alpha.36.3"
            },
            {
              "path": "$.execution_locks.workbook_read_enabled",
              "equals": false
            },
            {
              "path": "$.execution_locks.builder_engine_execution_enabled",
              "equals": false
            },
            {
              "path": "$.execution_locks.legacy_builder_callable",
              "equals": false
            },
            {
              "path": "$.execution_locks.excel_output_enabled",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "T01_CREATE_BOQ_NEGATIVE_POLARITY",
      "reset_conversation": true,
      "steps": [
        {
          "name": "chat_001",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {
            "conversation_id": "alpha35_10_01",
            "client_event_id": "alpha35_10_01_chat",
            "text": "Create BOQ but do not read workbook contents"
          },
          "assertions": [
            {
              "path": "$.route",
              "equals": "new_builder_task_shell"
            },
            {
              "path": "$.fallback_used",
              "equals": false
            },
            {
              "path": "$.route_context.no_active_language.requires_setup",
              "equals": true
            },
            {
              "path": "$.readiness.safety.workbook_read",
              "equals": false
            },
            {
              "path": "$.readiness.safety.engine_called",
              "equals": false
            },
            {
              "path": "$.readiness.safety.excel_created",
              "equals": false
            },
            {
              "path": "$.readiness.safety.legacy_builder_called",
              "equals": false
            }
          ]
        }
      ]
    },
