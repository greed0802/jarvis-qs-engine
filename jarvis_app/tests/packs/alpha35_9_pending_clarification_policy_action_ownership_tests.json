            "client_event_id": "alpha35_10_pack_policy_follow",
            "text": "Review workbook read policy"
          },
          "assertions": [
            {
              "path": "$.route",
              "equals": "builder_workbook_read_policy_review"
            },
            {
              "path": "$.blocked",
              "equals": false
            },
            {
              "path": "$.pending_clarification_id",
              "exists": true
            },
            {
              "path": "$.reason",
              "equals": "pending_clarification_read_only_policy_review_allowed"
            },
            {
              "path": "$.fallback_used",
              "equals": false
            },
            {
              "path": "$.reducer_result.plan_mutated",
              "equals": false
            },
            {
              "path": "$.reducer_result.pending_clarification_preserved",
              "equals": true
            },
            {
              "path": "$.workbook_read",
              "equals": false
            },
            {
              "path": "$.engine_called",
              "equals": false
            },
            {
              "path": "$.excel_created",
              "equals": false
            },
            {
              "path": "$.legacy_builder_called",
              "equals": false
            }
          ]
        }
      ]
    },
    {
