{
  "pack_name": "alpha35_10_pending_clarification_policy_action_ownership_tests",
  "version_target": "v5.0.0-alpha.36.3",
  "format": "multi_step",
  "tests": [
    {
      "name": "VERSION_ALPHA35_10_PENDING_LOCKS",
      "reset_conversation": true,
      "steps": [
        {
          "name": "version",
          "method": "GET",
          "endpoint": "/api/version",
          "assertions": [
            {
              "path": "$.version",
              "equals": "v5.0.0-alpha.36.3"
            },
            {
              "path": "$.execution_locks.workbook_read_enabled",
              "equals": false
            },
            {
              "path": "$.execution_locks.builder_engine_execution_enabled",
              "equals": false
            },
            {
              "path": "$.execution_locks.legacy_builder_callable",
              "equals": false
            },
            {
              "path": "$.execution_locks.excel_output_enabled",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "PENDING_JOINERY_READ_CELLS_BLOCKED",
      "reset_conversation": true,
      "steps": [
        {
          "name": "start",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {
            "conversation_id": "alpha35_10_pack_read",
            "client_event_id": "alpha35_10_pack_read_start",
            "text": "Build me a BOQ"
          },
          "assertions": [
            {
              "path": "$.route",
              "equals": "new_builder_task_shell"
            }
          ]
        },
        {
          "name": "pending_trade",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {
            "conversation_id": "alpha35_10_pack_read",
            "client_event_id": "alpha35_10_pack_read_trade",
            "text": "Use Joinery"
          },
          "assertions": [
            {
              "path": "$.route",
              "equals": "active_task_slot_edit_needs_clarification"
            },
            {
              "path": "$.pending_clarification_id",
              "exists": true
            },
            {
              "path": "$.reducer_result.plan_mutated",
              "equals": false
            }
          ]
        },
        {
          "name": "follow",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {
            "conversation_id": "alpha35_10_pack_read",
            "client_event_id": "alpha35_10_pack_read_follow",
            "text": "Read cells after approval"
          },
          "assertions": [
            {
              "path": "$.route",
              "equals": "clarification_blocked_action"
            },
            {
              "path": "$.blocked",
              "equals": true
            },
            {
              "path": "$.pending_clarification_id",
              "exists": true
            },
            {
              "path": "$.reason",
              "equals": "pending_clarification_blocks_risky_action"
            }
          ]
        }
      ]
    },
