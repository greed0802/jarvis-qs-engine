{
  "pack_name": "alpha30_workbook_read_preflight_contract_tests",
  "version_target": "v5.0.0-alpha.36.3",
  "format": "multi_step",
  "tests": [
    {
      "name": "VERSION_ALPHA30_WORKBOOK_READ_PREFLIGHT_LOCKS",
      "reset_conversation": true,
      "steps": [
        {
          "name": "version",
          "method": "GET",
          "endpoint": "/api/version",
          "assertions": [
            {
              "path": "$.version",
              "equals": "v5.0.0-alpha.36.3"
            },
            {
              "path": "$.scope",
              "equals": "workbook_read_policy_review_no_content_read"
            },
            {
              "path": "$.scope_metadata.workbook_read_preflight_contract",
              "equals": true
            },
            {
              "path": "$.scope_metadata.workbook_read_preflight_metadata_only",
              "equals": true
            },
            {
              "path": "$.scope_metadata.workbook_parse_enabled",
              "equals": false
            },
            {
              "path": "$.execution_locks.workbook_read_enabled",
              "equals": false
            },
            {
              "path": "$.execution_locks.builder_engine_execution_enabled",
              "equals": false
            },
            {
              "path": "$.execution_locks.legacy_builder_callable",
              "equals": false
            },
            {
              "path": "$.execution_locks.excel_output_enabled",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "PREFLIGHT_NO_CONTRACT_BLOCKS_SAFELY",
      "reset_conversation": true,
      "steps": [
        {
          "name": "preflight_no_contract",
          "method": "POST",
          "endpoint": "/api/builder/workbook-read-preflight-dry-run",
          "json": {
            "conversation_id": "pack_alpha30_no_contract",
            "client_event_id": "preflight_no_contract"
          },
          "assertions": [
            {
              "path": "$.route",
              "equals": "builder_workbook_read_preflight_dry_run"
            },
            {
              "path": "$.metadata_only",
              "equals": true
            },
            {
              "path": "$.preflight_only",
              "equals": true
            },
            {
              "path": "$.execution_enabled",
              "equals": false
            },
            {
              "path": "$.blocked",
              "equals": true
            },
            {
              "path": "$.reason",
              "equals": "engine_contract_not_found"
            },
            {
              "path": "$.contract_found",
              "equals": false
            },
            {
              "path": "$.workbook_ref_found",
              "equals": false
            },
            {
              "path": "$.workbook_opened",
              "equals": false
            },
            {
              "path": "$.workbook_read",
              "equals": false
            },
            {
              "path": "$.workbook_parsed",
              "equals": false
            },
            {
              "path": "$.sheet_names_read",
              "equals": false
            },
            {
              "path": "$.cells_read",
              "equals": false
            },
            {
              "path": "$.formulas_read",
              "equals": false
            },
            {
              "path": "$.engine_called",
              "equals": false
            },
            {
              "path": "$.excel_created",
              "equals": false
            },
            {
              "path": "$.legacy_builder_called",
              "equals": false
            },
            {
              "path": "$.raw_path_value_returned",
              "equals": false
            },
            {
              "path": "$.forbidden_path_key_returned",
              "equals": false
            },
            {
              "path": "$.saved_path",
              "not_exists": true
            },
            {
              "path": "$.path",
              "not_exists": true
            }
          ]
        }
      ]
    },
    {
      "name": "PREFLIGHT_READY_CONTRACT_METADATA_ONLY_SCRUBBED",
      "reset_conversation": true,
      "steps": [
        {
          "name": "start",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {
            "conversation_id": "pack_alpha30_contract",
            "client_event_id": "start",
            "text": "Build me a BOQ"
          },
          "assertions": [
            {
              "path": "$.route",
              "equals": "new_builder_task_shell"
            }
          ]
        },
        {
          "name": "attach",
          "method": "POST",
          "endpoint": "/api/attach",
          "form": {
            "conversation_id": "pack_alpha30_contract",
            "client_event_id": "attach",
            "text": "Here"
          },
          "file_fixture": "Test.xlsx",
          "assertions": [
            {
              "path": "$.route",
              "equals": "attachment_bind"
            },
            {
              "path": "$.reducer_result.workbook_read",
              "equals": false
            }
          ]
        },
        {
          "name": "trade",
          "method": "POST",
          "endpoint": "/api/chat",
