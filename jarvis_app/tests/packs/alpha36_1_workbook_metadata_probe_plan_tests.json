{
  "pack_name": "alpha36_1_workbook_metadata_probe_plan_tests",
  "version_target": "v5.0.0-alpha.36.3",
  "format": "multi_step",
  "tests": [
    {
      "name": "T01_VERSION_ALPHA36_1_LOCKS",
      "reset_conversation": true,
      "steps": [
        {
          "name": "version",
          "method": "GET",
          "endpoint": "/api/version",
          "assertions": [
            {
              "path": "$.version",
              "equals": "v5.0.0-alpha.36.3"
            },
            {
              "path": "$.execution_locks.workbook_read_enabled",
              "equals": false
            },
            {
              "path": "$.execution_locks.builder_engine_execution_enabled",
              "equals": false
            },
            {
              "path": "$.execution_locks.legacy_builder_callable",
              "equals": false
            },
            {
              "path": "$.execution_locks.excel_output_enabled",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "T02_METADATA_PROBE_PLAN_POLICY_NO_READ_DEFAULTS",
      "reset_conversation": true,
      "steps": [
        {
          "name": "policies",
          "method": "GET",
          "endpoint": "/api/registry/execution-policies",
          "assertions": [
            {
              "path": "$.policies[13].policy_key",
              "equals": "workbook_metadata_probe_plan"
            },
            {
              "path": "$.policies[13].metadata_only",
              "equals": true
            },
            {
              "path": "$.policies[13].execution_enabled",
              "equals": false
            },
            {
              "path": "$.policies[13].workbook_read",
              "equals": false
            },
            {
              "path": "$.policies[13].workbook_content_read",
              "equals": false
            },
            {
              "path": "$.policies[13].sheet_name_probe_allowed",
              "equals": false
            },
            {
              "path": "$.policies[13].formula_read",
              "equals": false
            },
            {
              "path": "$.policies[13].cell_value_read",
              "equals": false
            },
            {
              "path": "$.policies[13].style_read",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "T03_SHEET_NAME_PROBE_CAPABILITY_NOT_ENABLED",
      "reset_conversation": true,
      "steps": [
        {
          "name": "capabilities",
          "method": "GET",
          "endpoint": "/api/registry/capabilities",
          "assertions": [
            {
              "path": "$.capabilities[46].capability_key",
              "equals": "sheet_name_only_probe_contract"
            },
            {
              "path": "$.capabilities[46].execution_enabled",
              "equals": false
            },
            {
              "path": "$.capabilities[46].sheet_name_probe_allowed",
              "equals": false
            },
            {
              "path": "$.capabilities[46].workbook_read",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "T04_CONTENT_FORMULA_CELL_STYLE_READS_BLOCKED",
      "reset_conversation": true,
      "steps": [
        {
          "name": "capabilities",
          "method": "GET",
          "endpoint": "/api/registry/capabilities",
          "assertions": [
            {
              "path": "$.capabilities[45].workbook_content_read",
              "equals": false
            },
            {
              "path": "$.capabilities[45].formula_read",
              "equals": false
            },
            {
              "path": "$.capabilities[45].cell_value_read",
              "equals": false
            },
            {
              "path": "$.capabilities[45].style_read",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "T05_APPROVAL_DOES_NOT_ENABLE_PROBE_IN_ALPHA36_1",
      "reset_conversation": true,
      "steps": [
        {
          "name": "files",
          "method": "GET",
          "endpoint": "/api/registry/file-requirements",
          "assertions": [
            {
              "path": "$.file_requirements[65].file_key",
              "equals": "sheet_name_probe_approval_future"
            },
            {
              "path": "$.file_requirements[65].execution_enabled",
              "equals": false
            },
            {
              "path": "$.file_requirements[65].sheet_name_probe_allowed",
              "equals": false
            },
            {
              "path": "$.file_requirements[65].workbook_read",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "T06_DIRECT_PROBE_STILL_SAFE_BLOCKED",
      "reset_conversation": true,
      "steps": [
        {
          "name": "chat",
          "method": "POST",
          "endpoint": "/api/chat",
          "json": {
            "conversation_id": "alpha361_pack_direct_probe_block",
            "client_event_id": "alpha361_pack_direct_probe_block",
            "text": "Read this workbook and list sheet names, formulas, and cell values."
          },
          "assertions": [
            {
              "path": "$.workbook_read",
              "equals": false
            },
            {
              "path": "$.engine_called",
              "equals": false
            },
            {
              "path": "$.excel_created",
              "equals": false
            },
            {
              "path": "$.legacy_builder_called",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "T07_ALPHA36_0_INTEGRITY_CONTRACT_STILL_BLOCKS_PROBE",
      "reset_conversation": true,
      "steps": [
        {
          "name": "policies",
          "method": "GET",
          "endpoint": "/api/registry/execution-policies",
          "assertions": [
            {
              "path": "$.policies[10].policy_key",
              "equals": "pre_execution_integrity_matrix"
            },
            {
              "path": "$.policies[10].execution_enabled",
              "equals": false
            },
            {
              "path": "$.policies[10].sheet_name_probe_allowed",
              "equals": false
            },
            {
              "path": "$.policies[10].workbook_read",
              "equals": false
            },
            {
              "path": "$.policies[12].policy_key",
              "equals": "sheet_name_probe_readiness_gates"
            },
            {
              "path": "$.policies[12].sheet_name_probe_allowed",
              "equals": false
            }
          ]
        }
      ]
    },
    {
      "name": "T08_ALPHA35_19_PERMISSION_EVIDENCE_LOCK_STILL_SAFE",
      "reset_conversation": true,
      "steps": [
        {
          "name": "policies",
          "method": "GET",
          "endpoint": "/api/registry/execution-policies",
          "assertions": [
            {
              "path": "$.policies[9].policy_key",
              "equals": "workbook_read_permission_contract"
            },
            {
              "path": "$.policies[9].workbook_read",
              "equals": false
            },
            {
              "path": "$.policies[9].workbook_content_read",
              "equals": false
            },
            {
              "path": "$.policies[9].formula_read",
              "equals": false
            },
            {
              "path": "$.policies[9].cell_value_read",
              "equals": false
            }
          ]
        }
      ]
    }
  ]
}
