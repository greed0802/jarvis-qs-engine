            {
              "path": "$.contract_only",
              "equals": true
            }
          ],
          "save": {
            "contract_id": "$.contract_id"
          }
        },
        {
          "name": "fixture_replay",
          "method": "POST",
          "endpoint": "/api/builder/contract-fixture-replay",
          "json": {
            "conversation_id": "alpha19_pack_wall_clean",
